# Example Environment Configuration for OCI Deployment Script
# Copy this file to .env and fill in your values
# Then source it before running the deployment: source .env

# Required: Your OCI Stack ID
# Get this from OCI Console > Resource Manager > Stacks
export OCI_STACK_ID="ocid1.ormstack.oc1.iad.aaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Compartment ID (if needed)
export OCI_COMPARTMENT_ID="ocid1.compartment.oc1..aaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Retry Configuration
# Maximum number of retry attempts (default: 10)
export OCI_MAX_RETRIES=10

# Initial wait time in seconds between retries (default: 30)
export OCI_INITIAL_WAIT=30

# Maximum wait time in seconds (default: 300)
export OCI_MAX_WAIT=300

# OCI CLI Configuration (optional - uses default if not set)
# export OCI_CLI_PROFILE="DEFAULT"
# export OCI_CLI_CONFIG_FILE="~/.oci/config"

# Terraform Configuration Source (optional)
export OCI_CONFIG_SOURCE="./terraform-example"
